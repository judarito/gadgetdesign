# Plantilla de credenciales para el entorno de PRUEBAS (rama dev).
#
# Uso:
#   cp .env.dev.example .env.dev.local
#   # completa TURSO_TOKEN con:  turso db tokens create gadgetdesign-dev
#
# .env.dev.local está ignorado por git (*.local). Nunca lo subas.
#
# Estas credenciales NO deben coincidir con las de producción: usa una base de
# datos, un APP_AUTH_SECRET y un DATA_ENCRYPTION_KEY distintos. Así un fallo en
# pruebas no puede falsificar sesiones ni descifrar datos de producción.

TURSO_URL=libsql://gadgetdesign-dev-jricardo.aws-us-east-1.turso.io
TURSO_TOKEN=your_turso_dev_auth_token
APP_AUTH_SECRET=64_hex_characters_distintos_a_produccion
DATA_ENCRYPTION_KEY=64_hex_characters_distintos_a_produccion
OTP_DELIVERY_MODE=console
RESEND_FROM="Gadget Design <acceso@example.com>"
