{
  "name": "gadgetdesign",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/devLocal.mjs",
    "dev:vite": "vite",
    "prebuild": "node scripts/writeBuildInfo.mjs",
    "build": "vite build",
    "verify:deploy": "npm run test:functions && npm run test:deploy-smoke && npm run build",
    "preview": "vite preview",
    "setup:local": "node scripts/setupLocal.mjs",
    "test:functions": "npm run setup:local && node scripts/testFunctions.mjs",
    "test:deploy-smoke": "node scripts/testDeploySmoke.mjs",
    "test:e2e": "playwright test",
    "check:syntax": "node scripts/checkSyntax.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .netlify --ignore-pattern node_modules",
    "verify": "npm run lint && npm run check:syntax && npm run test:functions && npm run test:deploy-smoke && npm run build",
    "setup:admin": "node scripts/setupAdmin.mjs",
    "setup:drop-legacy": "node scripts/dropLegacyOwnerColumns.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@lucide/vue": "^1.48.0",
    "@netlify/functions": "^6.0.2",
    "qrcode": "^1.5.4",
    "three": "^0.186.1",
    "vue": "^3.5.43",
    "vuetify": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "netlify-cli": "^27.10.1",
    "vite": "^8.3.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-eslint-parser": "^10.4.1"
  }
}
